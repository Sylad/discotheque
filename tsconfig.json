{
  // Racine : vérifie les scripts et configs JS du dépôt (checkJs). backend/, frontend/
  // auront leur propre tsconfig et leur propre entrée tsc dans cadence.yaml (L4).
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.mjs", "scripts/**/*.mjs"]
}
